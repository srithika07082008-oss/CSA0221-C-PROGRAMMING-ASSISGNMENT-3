#include <stdio.h>

static int steps;

int linear_search(const int a[], int n, int key) {
    steps = 0;
    for (int i = 0; i < n; ++i) {
        ++steps;
        if (a[i] == key) return i;
    }
    return -1;
}

int binary_search(const int a[], int n, int key) {
    int low = 0, high = n - 1;
    steps = 0;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        ++steps;                         /* one key-to-element comparison */
        if (a[mid] == key) return mid;
        if (a[mid] < key) low = mid + 1;
        else high = mid - 1;
    }
    return -1;
}

int main(void) {
    int a[] = {1021,1048,1103,1190,1222,1305,1377,1402,1460,1533};
    int keys[] = {1021,1305,1533,1400};
    int n = (int)(sizeof a / sizeof a[0]);
    for (int k = 0; k < 4; ++k) {
        int pos = binary_search(a, n, keys[k]);
        printf("Book %d -> index %d, comparisons = %d\n", keys[k], pos, steps);
    }
    return 0;
}
