#include <stdio.h>
#include <string.h>

typedef struct { long comparisons, moves; } Stats;

Stats bubble(int a[], int n) {
    Stats s = {0,0};
    for (int end = n - 1; end > 0; --end) {
        int changed = 0;
        for (int j = 0; j < end; ++j) {
            ++s.comparisons;
            if (a[j] > a[j+1]) {
                int t=a[j]; a[j]=a[j+1]; a[j+1]=t;
                ++s.moves; changed=1;
            }
        }
        if (!changed) break;
    }
    return s;                    /* moves counts swaps */
}

Stats selection(int a[], int n) {
    Stats s = {0,0};
    for (int i=0; i<n-1; ++i) {
        int min=i;
        for (int j=i+1; j<n; ++j) {
            ++s.comparisons;
            if (a[j] < a[min]) min=j;
        }
        if (min != i) {
            int t=a[i]; a[i]=a[min]; a[min]=t; ++s.moves;
        }
    }
    return s;
}

Stats insertion(int a[], int n) {
    Stats s = {0,0};
    for (int i=1; i<n; ++i) {
        int key=a[i], j=i-1;
        while (j>=0) {
            ++s.comparisons;
            if (a[j] <= key) break;
            a[j+1]=a[j]; ++s.moves; --j;
        }
        a[j+1]=key;
    }
    return s;                    /* moves counts shifts, not final placements */
}

static void run(const char *name, Stats s) {
    printf("%-12s comparisons=%ld swaps/shifts=%ld\n",
           name, s.comparisons, s.moves);
}
int main(void) {
    int source[]={6,2,5,1,4,3}, a[6];
    memcpy(a,source,sizeof a); run("bubble",bubble(a,6));
    memcpy(a,source,sizeof a); run("selection",selection(a,6));
    memcpy(a,source,sizeof a); run("insertion",insertion(a,6));
    return 0;
}
