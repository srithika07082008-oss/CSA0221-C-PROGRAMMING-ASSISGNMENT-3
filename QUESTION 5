#include <stdio.h>
#include <ctype.h>

int word_count(const char s[]) {
    int count=0, inside=0;
    for (int i=0;s[i]!='\0';++i) {
        if (s[i]!=' ') { if (!inside) ++count; inside=1; }
        else inside=0;
    }
    return count;
}
int is_palindrome(const char s[]) {
    int left=0,right=0;
    while (s[right]!='\0') ++right;
    --right;
    while (left<right) {
        while (left<right && !isalpha((unsigned char)s[left])) ++left;
        while (left<right && !isalpha((unsigned char)s[right])) --right;
        if (tolower((unsigned char)s[left]) !=
            tolower((unsigned char)s[right])) return 0;
        ++left; --right;
    }
    return 1;
}
void uppercase(char s[]) {
    for (int i=0;s[i]!='\0';++i)
        s[i]=(char)toupper((unsigned char)s[i]);
}
void reverse(char s[]) {
    int n=0; while (s[n]!='\0') ++n;
    for (int i=0;i<n/2;++i) {
        char t=s[i]; s[i]=s[n-1-i]; s[n-1-i]=t;
    }
}
int main(void) {
    char message[256]="Meet at the library at 5 PM";
    printf("Words: %d\n",word_count("  Meet at  the library at 5 PM "));
    printf("%d %d\n",is_palindrome("Madam, I'm Adam"),
           is_palindrome("Hello"));
    uppercase(message); printf("Upper: %s\n",message);
    reverse(message); printf("Reverse: %s\n",message);
    return 0;
}
