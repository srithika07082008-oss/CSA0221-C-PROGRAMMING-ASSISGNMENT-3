#include <stdio.h>
#include <string.h>

#define N 500
#define W 31                 /* permits 30 name bytes plus '\0' */

static void strip_newline(char s[]) {
    size_t n=strlen(s);
    if (n>0 && s[n-1]=='\n') s[n-1]='\0';
}
static void sort_names(char names[N][W], int n, long *calls,
                       long *copies) {
    char temp[W]; *calls=0; *copies=0;
    for (int i=1;i<n;++i) {
        int j=i;
        while (j>0) {
            ++*calls;
            if (strcmp(names[j-1],names[j])<=0) break;
            strcpy(temp,names[j-1]); *copies+=(long)strlen(temp)+1;
            strcpy(names[j-1],names[j]); *copies+=(long)strlen(names[j])+1;
            strcpy(names[j],temp); *copies+=(long)strlen(temp)+1;
            --j;
        }
    }
}
static int binary_find(char names[N][W], int n, const char *key,
                       long *calls) {
    int lo=0,hi=n-1; *calls=0;
    while (lo<=hi) {
        int mid=lo+(hi-lo)/2; ++*calls;
        int cmp=strcmp(names[mid],key);
        if (cmp==0) return mid;
        if (cmp<0) lo=mid+1; else hi=mid-1;
    }
    return -1;
}
int main(void) {
    static char names[N][W];
    int n;
    printf("Number of names (0..%d): ",N);
    if (scanf("%d",&n)!=1 || n<0 || n>N) return 1;
    int ch; while ((ch=getchar())!='\n' && ch!=EOF) { }
    for (int i=0;i<n;++i) {
        printf("Name %d: ",i+1);
        if (!fgets(names[i],W,stdin)) return 1;
        size_t len=strlen(names[i]);
        int had_newline=(len>0 && names[i][len-1]=='\n');
        strip_newline(names[i]);
        if (!had_newline && len==W-1) {
            /* Could be exactly full or truncated; reject conservatively. */
            int c=getchar();
            if (c!='\n' && c!=EOF) {
                while (c!='\n' && c!=EOF) c=getchar();
                fprintf(stderr,"Name too long (maximum %d bytes).\n",W-1);
                return 1;
            }
        }
    }
    long cmp,copies; sort_names(names,n,&cmp,&copies);
    printf("Sort strcmp calls=%ld, copied characters=%ld\n",cmp,copies);
    for (int i=0;i<n;++i) {
        puts(names[i]);
        if (i>0 && strcmp(names[i-1],names[i])==0)
            printf("Duplicate: %s\n",names[i]);
    }
    char key[W]; printf("Search name: ");
    if (!fgets(key,sizeof key,stdin)) return 1;
    strip_newline(key);
    long search_calls; int pos=binary_find(names,n,key,&search_calls);
    printf("index=%d comparisons=%ld\n",pos,search_calls);
    return 0;
}
